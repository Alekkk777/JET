# Chiave API Anthropic, necessaria solo per l'endpoint /api/v1/salary/explain (chatbot).
# Senza questa variabile il calcolo RAL -> netto funziona comunque, solo /explain fallirà.
ANTHROPIC_API_KEY=

# Modello da usare per la spiegazione (default: claude-haiku-4-5 — costa 1/2 di Sonnet 5,
# adeguato per spiegare in prosa numeri già calcolati, nessun ragionamento complesso richiesto)
ANTHROPIC_MODEL=claude-haiku-4-5
